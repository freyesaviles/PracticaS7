    {
      "name": "4. Eliminación final",
      "item": [
        {
          "name": "Eliminar producto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('El producto fue eliminado', function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/productos/{{productoId}}"
          }
        }
      ]
