{
  "info": {
    "_postman_id": "5d22c4a0-8b33-4a6f-9f5a-7f4f0b1c1a01",
    "name": "Lab1 - Gestión de productos (local)",
    "description": "Colección local para demostrar el Laboratorio 1 completo. Ejecutar las carpetas en orden. Usa variables con prefijo lab1 para evitar conflictos con environments de Postman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "lab1BaseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "lab1CategoriaId",
      "value": "2"
    },
    {
      "key": "lab1ProveedorId",
      "value": "2"
    },
    {
      "key": "lab1ProductoId",
      "value": "3"
    },
    {
      "key": "lab1EtiquetaOfertaId",
      "value": "3"
    },
    {
      "key": "lab1EtiquetaImportadoId",
      "value": "4"
    },
    {
      "key": "lab1EtiquetaEmpresarialId",
      "value": "5"
    },
    {
      "key": "lab1EtiquetaPortatilId",
      "value": "6"
    },
    {
      "key": "lab1EtiquetaGamingId",
