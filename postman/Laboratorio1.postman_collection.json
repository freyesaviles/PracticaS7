  "item": [
    {
      "name": "1. Datos base",
      "item": [
        {
          "name": "Crear categoría",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('sufijo', Date.now());",
                  "pm.collectionVariables.set('categoriaNombre', 'Lab1 Computadoras ' + pm.collectionVariables.get('sufijo'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('La categoría fue creada', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('lab1CategoriaId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"{{categoriaNombre}}\",\n  \"activa\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{lab1BaseUrl}}/api/categorias"
          }
        },
        {
          "name": "Crear proveedor",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('proveedorNombre', 'Lab1 Proveedor ' + pm.collectionVariables.get('sufijo'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('El proveedor fue creado', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('lab1ProveedorId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"{{proveedorNombre}}\",\n  \"telefono\": \"2255-0101\",\n  \"correo\": \"lab1-{{sufijo}}@example.com\",\n  \"activo\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{lab1BaseUrl}}/api/proveedores"
          }
        },
        {
          "name": "Consultar categorías",
          "request": {
            "method": "GET",
            "url": "{{lab1BaseUrl}}/api/categorias"
          }
        },
        {
          "name": "Consultar proveedores",
          "request": {
            "method": "GET",
            "url": "{{lab1BaseUrl}}/api/proveedores"
          }
        },
        {
          "name": "Consultar productos desde una categoría",
          "request": {
            "method": "GET",
            "url": "{{lab1BaseUrl}}/api/categorias/{{lab1CategoriaId}}/productos"
          }
        }
      ]
    },
    {
      "name": "2. CRUD de productos",
      "item": [
        {
          "name": "Crear producto",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('productoCodigo', 'LAB1-' + pm.collectionVariables.get('sufijo'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('El producto fue creado', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('lab1ProductoId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo\": \"{{productoCodigo}}\",\n  \"nombre\": \"Teclado mecanico Lab1\",\n  \"descripcion\": \"Producto de demostracion del Laboratorio 1\",\n  \"precioVenta\": 75.50,\n  \"existencia\": 20,\n  \"categoriaId\": {{lab1CategoriaId}},\n  \"proveedorId\": {{lab1ProveedorId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{lab1BaseUrl}}/api/productos"
          }
        },
        {
          "name": "Listar productos",
          "request": {
            "method": "GET",
            "url": "{{lab1BaseUrl}}/api/productos"
          }
        },
        {
          "name": "Buscar producto por ID",
          "request": {
            "method": "GET",
            "url": "{{lab1BaseUrl}}/api/productos/{{lab1ProductoId}}"
          }
        },
        {
          "name": "Actualizar producto",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo\": \"{{productoCodigo}}\",\n  \"nombre\": \"Teclado mecanico Lab1 actualizado\",\n  \"descripcion\": \"Producto actualizado desde Postman\",\n  \"precioVenta\": 80.00,\n  \"existencia\": 25,\n  \"categoriaId\": {{lab1CategoriaId}},\n  \"proveedorId\": {{lab1ProveedorId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{lab1BaseUrl}}/api/productos/{{lab1ProductoId}}"
          }
        },
        {
          "name": "Listar productos por categoría",
          "request": {
            "method": "GET",
            "url": "{{lab1BaseUrl}}/api/productos/categoria/{{lab1CategoriaId}}"
          }
        }
      ]
    },
