          }
        },
        {
          "name": "Reto 1 - Quitar solo una asociación",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/productos/{{productoId}}/etiquetas/{{etiquetaGamingId}}"
          }
        },
        {
          "name": "Reto 2 - Verificar producto después de quitar asociación",
